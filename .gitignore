# Secrets / service accounts (never commit)
wavelength-*.json
*-service-account*.json
# Google Cloud / Firebase service-account keys are exported as
# <project-id>-<hash>.json, which no name pattern catches reliably.
# The real guard is .githooks/pre-commit, which matches on content.
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*.json
serviceAccount*.json
*credentials*.json

*.gcp.json
google-services.json
GoogleService-Info.plist

# Misc
app-example

# Playwright MCP test artifacts
.playwright-mcp/

# PartyKit local dev state (sqlite per Durable Object instance)
apps/backend/.partykit/

# agent-device test artifacts (screenshots, replay scripts, reports)
device-test-output/
