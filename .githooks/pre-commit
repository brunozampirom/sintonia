#!/bin/sh
# Block commits whose staged content looks like a credential.
# Name-based .gitignore rules miss files like <project>-<hash>.json,
# which is how Google Cloud exports service-account keys.

if git diff --cached -U0 | grep -qE '(BEGIN [A-Z ]*PRIVATE KEY|"private_key"[[:space:]]*:|AIza[0-9A-Za-z_-]{30,}|sk-[A-Za-z0-9]{32,}|ghp_[A-Za-z0-9]{30,}|AKIA[0-9A-Z]{16})'; then
  echo ""
  echo "  ✗ Commit blocked: the staged changes look like they contain a credential."
  echo ""
  echo "    Matched one of: private key block, service-account private_key,"
  echo "    Google API key, OpenAI key, GitHub token, AWS access key."
  echo ""
  echo "    Move it to an environment variable or EAS secret."
  echo "    If this is a false positive: git commit --no-verify"
  echo ""
  exit 1
fi
