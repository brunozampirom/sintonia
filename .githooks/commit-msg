#!/bin/sh
# Validates the commit message: Conventional Commits, a subject short enough to
# read in `git log --oneline`, and no em dashes.
#
# Bypass with `git commit --no-verify` when you genuinely need to.

MSG_FILE="$1"

# Strip comment lines git adds to the template.
BODY=$(grep -v '^#' "$MSG_FILE")
SUBJECT=$(printf '%s\n' "$BODY" | sed '/^$/d' | head -1)

fail() {
  echo ""
  echo "  ✗ $1"
  echo ""
  [ -n "$2" ] && { echo "    $2"; echo ""; }
  echo "    Subject: $SUBJECT"
  echo ""
  exit 1
}

# Merges, reverts and fixups are generated by git; leave them alone.
case "$SUBJECT" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'

printf '%s' "$SUBJECT" | grep -qE "^($TYPES)(\([a-z0-9._/-]+\))?!?: .+" || fail \
  "Subject is not a Conventional Commit." \
  "Expected  type(scope): summary   with type one of: $(echo $TYPES | tr '|' ' ')"

LEN=$(printf '%s' "$SUBJECT" | wc -c | tr -d ' ')
[ "$LEN" -le 72 ] || fail \
  "Subject is $LEN characters; the limit is 72." \
  "Anything past that gets cut off in git log and on GitHub."

printf '%s' "$SUBJECT" | grep -qE ': [a-z]' || fail \
  "Subject starts with a capital after the colon." \
  "Conventional Commits wants lowercase: 'fix(api): handle empty payload'."

case "$SUBJECT" in
  *.) fail "Subject ends with a period." "Drop it; the subject is a title, not a sentence." ;;
esac

printf '%s' "$BODY" | grep -q '—\|–' && fail \
  "The message contains an em dash or en dash." \
  "Use a period, a comma, a colon or parentheses instead."

# A body has to be separated from the subject by a blank line, or git treats the
# whole thing as one long subject.
SECOND=$(printf '%s\n' "$BODY" | sed -n '2p')
[ -z "$SECOND" ] || fail \
  "Line 2 is not blank." \
  "Leave an empty line between the subject and the body."

exit 0
