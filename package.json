{
  "name": "sintonia",
  "version": "3.0.0",
  "description": "A party game about reading other people's minds, around a table or across the internet.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/brunozampirom/sintonia"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:mobile": "pnpm --filter @sintonia/mobile start",
    "ios": "pnpm --filter @sintonia/mobile ios",
    "android": "pnpm --filter @sintonia/mobile android",
    "dev:web": "pnpm --filter @sintonia/web dev",
    "dev:backend": "pnpm --filter @sintonia/backend dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "~5.9.2"
  }
}
